# ==========================================
# AI News Pulse - Environment Variables
# ==========================================

# ------------------------------------------
# 1. SUPABASE DATABASE CONFIGURATION
# ------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ------------------------------------------
# 2. OPENROUTER AI CONFIGURATION
# ------------------------------------------
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Recommended Model: google/gemini-2.5-flash-lite (or google/gemini-2.0-flash-001, deepseek/deepseek-chat)
OPENROUTER_MODEL=google/gemini-2.5-flash-lite
OPENROUTER_SITE_URL=https://ainewspulse.vercel.app
OPENROUTER_SITE_NAME=AI News Pulse

# ------------------------------------------
# 3. X (TWITTER) / NEWS SCRAPING
# ------------------------------------------
# Optional X / Twitter API Bearer Token (if you have standard/developer access)
X_BEARER_TOKEN=
# Optional Jina AI Reader API Key (for high-speed markdown extraction from any web/X link)
JINA_API_KEY=

# ------------------------------------------
# 4. TELEGRAM NOTIFICATIONS
# ------------------------------------------
# Get bot token from @BotFather
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGhIJKlmNoPQRstuVWXyz
# Chat ID, Group ID, or Channel username (e.g. -1001234567890 or @your_channel)
TELEGRAM_CHAT_ID=-1001234567890

# ------------------------------------------
# 5. WHATSAPP NOTIFICATIONS
# ------------------------------------------
# Provider options: green_api | twilio | meta_cloud | custom_webhook
WHATSAPP_PROVIDER=green_api
# Green-API credentials (from green-api.com) or Twilio SID/Auth
WHATSAPP_INSTANCE_ID=
WHATSAPP_API_TOKEN=
# Target phone number in international format without + or spaces (e.g., 213555123456) or Group Chat ID
WHATSAPP_TARGET_NUMBER=

# ------------------------------------------
# 6. APP SECURITY & AUTHENTICATION
# ------------------------------------------
# Dashboard Admin Credentials
DASHBOARD_ADMIN_USER=admin
DASHBOARD_ADMIN_PASSWORD=SahelIntel2026!*
# A secret string to protect the Vercel cron endpoint from unauthorized calls
CRON_SECRET=super_secure_cron_secret_token_12345
# Default delivery language: ar (Arabic) | fr (French) | en (English) | dual_ar_fr
DEFAULT_LANGUAGE=ar

